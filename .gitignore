# Environment files
/.env
import hashlib
import hmac
import os


def hash_password(password: str, salt: bytes | None = None) -> tuple[bytes, bytes]:
    if salt is None:
        salt = os.urandom(16)
    pwd_hash = hashlib.scrypt(
        password.encode("utf-8"),
        salt=salt,
        n=16384,
        r=8,
        p=1,
    )
    return salt, pwd_hash


# Example: generate a salt + hash once and load them from environment variables
# or a database rather than hardcoding a plaintext password in code.
EXPECTED_USERNAME = os.getenv("APP_ADMIN_USER", "admin")
STORED_SALT_HEX = os.getenv("APP_ADMIN_SALT")
STORED_HASH_HEX = os.getenv("APP_ADMIN_HASH")


def check_login(username: str, password: str) -> bool:
    if not isinstance(username, str) or not isinstance(password, str):
        return False
    if not STORED_SALT_HEX or not STORED_HASH_HEX:
        raise RuntimeError("Authentication secrets are not configured.")

    salt = bytes.fromhex(STORED_SALT_HEX)
    expected_hash = bytes.fromhex(STORED_HASH_HEX)
    _, actual_hash = hash_password(password, salt=salt)

    user_matches = hmac.compare_digest(
        username.encode("utf-8"),
        EXPECTED_USERNAME.encode("utf-8"),
    )
    password_matches = hmac.compare_digest(actual_hash, expected_hash)

    return user_matches and password_matches

